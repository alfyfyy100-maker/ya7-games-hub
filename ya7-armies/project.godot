; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but this file is generated by the project foundation and safe to edit.

config_version=5

[application]

config/name="Ya7 Armies"
config/description="Top-down cartoon RTS foundation (8-Bit Armies style) - Godot 4.x / GDScript / 3D"
run/main_scene="res://maps/Main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[autoload]

RNG="*res://autoload/RNG.gd"
GameConfig="*res://autoload/GameConfig.gd"
GameState="*res://autoload/GameState.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/Cairo.ttf"
theme/default_font_multichannel_signed_distance_field=true

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=30

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=1024
anti_aliasing/quality/msaa_3d=0
